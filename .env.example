# ─── SQA Agent configuration ─────────────────────────────────────────
# Copy to .env and fill in what you need. Everything is optional —
# defaults give you a local, open dashboard.

# REQUIRED on any publicly reachable deployment. All API routes (except
# /health) will require this key; the dashboard will prompt for it.
SQA_API_TOKEN=

# Dashboard port (default 8080)
SQA_DASHBOARD_PORT=8080

# Allow scanning localhost/private-network targets (dev only — never on a VPS)
SQA_ALLOW_PRIVATE=false

# ─── AI test planning (optional but recommended) ─────────────────────
# Free Z.ai key: create ~/.z-ai-config with {"baseUrl": "...", "apiKey": "..."}
# No LLM = rules-based checks only.

# ─── Issue tracker (auto-file findings as tickets) ───────────────────
# none | github | jira | console
SQA_ISSUE_TRACKER=none
# GitHub:
SQA_GITHUB_REPO=
SQA_GITHUB_TOKEN=
# Jira:
SQA_JIRA_BASE_URL=
SQA_JIRA_EMAIL=
SQA_JIRA_API_TOKEN=
SQA_JIRA_PROJECT_KEY=
# Minimum severity to file (medium | high | critical). Default medium.
SQA_TRACKER_MIN_SEVERITY=medium
# Log what would be filed without calling the tracker API.
SQA_TRACKER_DRY_RUN=false

# ─── Webhook notifications (Discord/Slack/generic) ───────────────────
# Receives POST {runId, url, score, status, findings[], reportUrl}
SQA_WEBHOOK_URL=
# Public URL of this dashboard (used in the reportUrl of webhook payloads)
SQA_PUBLIC_URL=

# ─── Scheduler (monitoring loop) ─────────────────────────────────────
# false = monitors never trigger automatically
SQA_SCHEDULER_ENABLED=true
# How often the scheduler checks for due monitors (ms). Default 60000.
SQA_SCHEDULER_INTERVAL_MS=60000

# ─── Limits / retention ──────────────────────────────────────────────
MAX_CONCURRENT_RUNS=2
SQA_MAX_RUN_MS=600000
SQA_MAX_PAGES_HARD=100
SQA_CLEANUP_MS=86400000
